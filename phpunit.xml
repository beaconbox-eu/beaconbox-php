<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         cacheDirectory=".phpunit.cache"
         failOnWarning="true"
         failOnRisky="true">
  <testsuites>
    <!-- The default suite. Hermetic: no network, no Docker, no setup. -->
    <testsuite name="beaconbox">
      <directory>tests</directory>
      <exclude>tests/Live</exclude>
    </testsuite>
    <!-- Opt-in. Needs a real BeaconBox: see ../mise.toml, task `live`. -->
    <testsuite name="live">
      <directory>tests/Live</directory>
    </testsuite>
  </testsuites>
  <source>
    <include><directory>src</directory></include>
  </source>
</phpunit>
