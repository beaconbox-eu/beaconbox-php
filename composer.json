{
    "name": "beaconbox/beaconbox-php",
    "description": "Official PHP SDK for BeaconBox, order updates your customers actually receive.",
    "type": "library",
    "license": "MIT",
    "homepage": "https://beaconbox.eu",
    "keywords": ["beaconbox", "notifications", "transactional", "sms", "whatsapp", "eu"],
    "authors": [
        { "name": "BeaconBox", "email": "sdk@beaconbox.eu" }
    ],
    "support": {
        "issues": "https://github.com/beaconbox-eu/beaconbox-php/issues",
        "source": "https://github.com/beaconbox-eu/beaconbox-php",
        "docs": "https://docs.beaconbox.eu"
    },
    "require": {
        "php": ">=8.1",
        "ext-curl": "*",
        "ext-json": "*",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.0",
        "psr/log": "^1.1 || ^2.0 || ^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "phpstan/phpstan": "^2.0",
        "nyholm/psr7": "^1.8"
    },
    "suggest": {
        "php-http/discovery": "Auto-wire a PSR-18 HTTP client + PSR-17 factories instead of the bundled curl transport."
    },
    "autoload": {
        "psr-4": { "BeaconBox\\": "src/" }
    },
    "autoload-dev": {
        "psr-4": { "BeaconBox\\Tests\\": "tests/" }
    },
    "scripts": {
        "test": "phpunit --testsuite beaconbox",
        "test:live": "phpunit --testsuite live",
        "analyse": "phpstan analyse --memory-limit=1G"
    },
    "config": {
        "sort-packages": true,
        "platform": { "php": "8.1.99" }
    },
    "minimum-stability": "stable"
}
